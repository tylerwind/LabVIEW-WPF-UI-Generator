<UserControl x:Class="WpfIconButton.IconButtonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{{ControlBackground}}"
             x:Name="root"
             MouseLeftButtonUp="UserControl_MouseLeftButtonUp"
             MouseLeftButtonDown="UserControl_MouseLeftButtonDown"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled">

    <Grid Margin="{{ShadowMargin}}">
        <!-- 区域①: 左上外侧亮色高光 -->
        <Border x:Name="LightShadowBorder" CornerRadius="{{CornerRadius}}">
            <Border.Effect>
                <DropShadowEffect x:Name="LightShadow"
                                  BlurRadius="{{ShadowBlur}}"
                                  Direction="135"
                                  ShadowDepth="{{ShadowDepth}}"
                                  Color="{{HighlightColor}}"
                                  Opacity="{{HighlightOpacity}}" />
            </Border.Effect>
            <Border.Background>
                <SolidColorBrush Color="Transparent" />
            </Border.Background>
        </Border>

        <!-- 区域③: 右下外侧暗色阴影 -->
        <Border x:Name="MainBorder" CornerRadius="{{CornerRadius}}" RenderTransformOrigin="0.5,0.5" Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect x:Name="PartShadow"
                                  BlurRadius="{{ShadowBlur}}"
                                  Direction="315"
                                  ShadowDepth="{{ShadowDepth}}"
                                  Color="{{ShadowColor}}"
                                  Opacity="{{ShadowOpacity}}" />
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ScaleTrans" ScaleX="1.0" ScaleY="1.0" />
                    <TranslateTransform x:Name="PosTrans" X="0" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{{GradientStart}}" Offset="0.0"/>
                    <GradientStop Color="{{GradientMid}}" Offset="0.5"/>
                    <GradientStop Color="{{GradientEnd}}" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <!-- Pressed state inset border -->
                <Border x:Name="InsetBorder" CornerRadius="{{CornerRadius}}" Visibility="Collapsed" Background="{{ControlBackground}}">
                    <Grid>
                        <Border BorderThickness="1.5,1.5,0,0" BorderBrush="#25000000" CornerRadius="{{CornerRadius}}"/>
                        <Border BorderThickness="0,0,1.5,1.5" BorderBrush="White" CornerRadius="{{CornerRadius}}"/>
                    </Grid>
                </Border>

                <!-- 悬浮高亮层 -->
                <Border x:Name="HoverOverlay" CornerRadius="{{CornerRadius}}" Opacity="0">
                    <Border.Background>
                        <SolidColorBrush Color="{{HighlightColor}}" />
                    </Border.Background>
                </Border>

                <!-- 内边框容器 -->
                <Border x:Name="InnerBorder" CornerRadius="{{CornerRadius}}" BorderThickness="{{BorderThickness}}">
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="InputBorderBrush" Color="{{BorderColor}}"/>
                    </Border.BorderBrush>

                    <Grid Margin="{{CardPadding}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 图标宿主 -->
                            <Grid x:Name="IconHost" Width="24" Height="24" Margin="0,0,8,0">
                                <Border Background="{{ControlBackground}}" CornerRadius="6">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="IconShadow" BlurRadius="4" ShadowDepth="1.2" Direction="315" Color="{{ShadowColor}}" Opacity="{{ShadowOpacity}}"/>
                                    </Border.Effect>
                                </Border>
                                <Border BorderBrush="White" BorderThickness="0.8,0.8,0,0" CornerRadius="6" Opacity="0.8"/>
                                <Grid Margin="5">
                                    <TextBlock x:Name="TxtIcon" Text="{Binding IconText, ElementName=root}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontFamily="{{FontFamily}}" Foreground="{{FontColor}}"/>
                                    <Image x:Name="ImgIcon" Source="{Binding IconPath, ElementName=root, TargetNullValue={x:Null}}" 
                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                                </Grid>
                            </Grid>

                            <!-- 标签文字 -->
                            <TextBlock x:Name="LabelBlock" Text="{Binding LabelText, ElementName=root}" 
                                       FontSize="{{FontSize}}" FontFamily="{{FontFamily}}" FontWeight="SemiBold" Foreground="{{FontColor}}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 底部激活指示条 -->
                <Border x:Name="ActiveIndicator" Height="3" Background="{{AccentColor}}" VerticalAlignment="Bottom" Margin="12,0,12,8" CornerRadius="1.5" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
