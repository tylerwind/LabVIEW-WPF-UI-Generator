<UserControl
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled" x:Class="{{Namespace}}.TreeListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="400" d:DesignWidth="400">

    <UserControl.Resources>
        <!-- 基础画刷资源支持运行时主题动态切换 -->
        <SolidColorBrush x:Key="TreeListFontBrush" Color="{{FontColor}}"/>
        <SolidColorBrush x:Key="TreeListLabelBrush" Color="{{LabelColor}}"/>
        <SolidColorBrush x:Key="TreeListAccentBrush" Color="{{AccentColor}}"/>
        <SolidColorBrush x:Key="TreeListBorderBrush" Color="{{BorderColor}}"/>
        <SolidColorBrush x:Key="TreeListBgBrush" Color="{{TreeBackground}}"/>
        <SolidColorBrush x:Key="TreeListHeaderBgBrush" Color="{{DataGridHeaderColor}}"/>

        <!-- Converter for Indentation -->
        <local:TreeList_IndentConverter x:Key="TreeList_IndentConverter" IndentSize="{{TreeIndentSize}}" xmlns:local="clr-namespace:{{Namespace}}" />
        <local:TreeList_NullToVisibilityConverter x:Key="TreeList_NullToVisibilityConverter" xmlns:local="clr-namespace:{{Namespace}}"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 树节点展开收缩的三角图标样式 (与 TreeControl 一致) -->
        <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Width="16" Height="16" Background="Transparent">
                            <Path x:Name="ExpandPath" 
                                  Fill="Transparent" 
                                  Stroke="{DynamicResource TreeListFontBrush}" 
                                  StrokeThickness="1.5"
                                  Data="M 4 4 L 10 9 L 4 14"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandPath" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!-- 鼠标悬浮时提亮 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpandPath" Property="Stroke" Value="{DynamicResource TreeListAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 扁平化 CheckBox 样式 (与 TreeControl 一致) -->
        <Style x:Key="TreeCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TreeListFontBrush}"/>
            <Setter Property="Margin" Value="4,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="CheckBorder" 
                                    Width="16" Height="16"
                                    BorderBrush="{DynamicResource TreeListBorderBrush}"
                                    BorderThickness="1"
                                    Background="Transparent"
                                    CornerRadius="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark" 
                                      Data="M 3 8 L 6 11 L 12 4" 
                                      Stroke="{DynamicResource TreeListBgBrush}" 
                                      StrokeThickness="2" 
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 选中状态 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource TreeListAccentBrush}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource TreeListAccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat ContextMenu Style (与 TreeControl 一致) -->
        <Style x:Key="FlatContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TreeListFontBrush}"/>
            <Setter Property="Background" Value="{DynamicResource TreeListBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TreeListBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{{BorderThickness}}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{{CornerRadius}}"
                                Margin="{{ShadowMargin}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="{{ShadowBlur}}" Direction="315" ShadowDepth="{{ShadowDepth}}" Color="{{ShadowColor}}" Opacity="{{ShadowOpacity}}"/>
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource TreeListFontBrush}"/>
            <Setter Property="FontFamily" Value="{{FontFamily}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListView Item Style (与 TreeControl 一致的配色与效果) -->
        <Style x:Key="TreeListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="{{TreeItemHeight}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TreeListFontBrush}"/>
            <Setter Property="FontFamily" Value="{{FontFamily}}"/>
            <Setter Property="FontSize" Value="{{FontSize}}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Margin="0,2">
                            <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#10888888"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25888888"/>
                                <Setter Property="Foreground" Value="{DynamicResource TreeListFontBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GridViewColumnHeader Style -->
        <Style x:Key="TreeListHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource TreeListHeaderBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TreeListLabelBrush}"/>
            <Setter Property="FontFamily" Value="{{FontFamily}}"/>
            <Setter Property="FontSize" Value="{{LabelFontSize}}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TreeListBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Multi-column Tree First Column DataTemplate -->
        <DataTemplate x:Key="FirstColumnTemplate">
            <StackPanel Orientation="Horizontal" Margin="{Binding IndentLevel, Converter={StaticResource TreeList_IndentConverter}}">
                <!-- 展开收折按钮 -->
                <ToggleButton x:Name="Expander" 
                              Style="{StaticResource ExpandCollapseToggleStyle}" 
                              IsChecked="{Binding IsExpanded, Mode=TwoWay}" 
                              Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <!-- 复选框 -->
                <CheckBox x:Name="NodeCheckBox" 
                          IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                          Style="{StaticResource TreeCheckBoxStyle}" 
                          VerticalAlignment="Center" 
                          {{NodeCheckBoxVisibility}}/>
                <!-- 图标 -->
                <Image Source="{Binding IconSource}" 
                       Width="16" 
                       Height="16" 
                       Margin="2,0,4,0" 
                       Visibility="{Binding IconSource, Converter={StaticResource TreeList_NullToVisibilityConverter}}"/>
                <!-- 文本 -->
                <TextBlock Text="{Binding ColumnTexts[0]}" 
                           Foreground="{DynamicResource TreeListFontBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 主容器，使用与原TreeControl一致的阴影外框 -->
    <Grid Margin="{{ShadowMargin}}">
        <Border CornerRadius="{{CornerRadius}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="{{ShadowBlur}}" Direction="315" ShadowDepth="{{ShadowDepth}}" Color="{{ShadowColor}}" Opacity="{{ShadowOpacity}}" />
            </Border.Effect>
            <!-- 渐变层基底 -->
            <Border x:Name="CardBackgroundBorder" Background="{DynamicResource TreeListBgBrush}" CornerRadius="{{CornerRadius}}">
                <Border x:Name="CardBorder" BorderBrush="{DynamicResource TreeListBorderBrush}" BorderThickness="{{BorderThickness}}" CornerRadius="{{CornerRadius}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 标签栏 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 内容 -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 控件顶部的标签区，支持开关 -->
                        <TextBlock x:Name="MainLabel" 
                                   Text="{{TreeLabelText}}" 
                                   Foreground="{DynamicResource TreeListLabelBrush}" 
                                   FontFamily="{{FontFamily}}" 
                                   FontSize="{{LabelFontSize}}" 
                                   Margin="{{CardPadding}}"
                                   Visibility="Visible"/>

                        <!-- 核心 ListView -->
                        <ListView x:Name="InnerList" Grid.Row="1" Margin="8,0,8,8" Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource TreeListFontBrush}"
                                  ItemContainerStyle="{StaticResource TreeListViewItemStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView x:Name="InnerGridView" ColumnHeaderContainerStyle="{StaticResource TreeListHeaderStyle}">
                                    <!-- Columns generated dynamically in CS -->
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </Border>
        </Border>
    </Grid>
</UserControl>
