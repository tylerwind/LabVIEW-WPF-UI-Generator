<UserControl
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled" x:Class="WpfTextInput.LedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{{ControlBackground}}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MouseLeftButtonDown="OnClick">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 标签：默认隐藏，固定字号，不随容器缩放 -->
        <TextBlock x:Name="LabelBlock"
                   Grid.Column="0"
                   Text="指示灯"
                   FontFamily="{{FontFamily}}"
                   FontSize="{{LabelFontSize}}"
                   Foreground="{{FontColor}}"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   Margin="8,0,10,0"/>

        <!-- LED 灯体：Viewbox 使其等比例填充容器可用空间 -->
        <Viewbox Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1">
            <Grid Width="32" Height="32">
                <!-- 外发光晕 (置于底层) -->
                <Border x:Name="LedHalo" Margin="1" Opacity="0" IsHitTestVisible="False" CornerRadius="{{CornerRadius}}">
                    <Border.Effect>
                        <BlurEffect Radius="{{ShadowBlur}}"/>
                    </Border.Effect>
                    <Border.Background>
                        <SolidColorBrush x:Name="HaloBrush" Color="{{LedActiveColor}}"/>
                    </Border.Background>
                </Border>
                <!-- 凹槽底座 -->
                <Border x:Name="BaseBorder" Margin="1.5" CornerRadius="{{CornerRadius}}">
                    <Border.Background>
                        <RadialGradientBrush>
                            <GradientStop Color="#C8CCD0" Offset="0.7"/>
                            <GradientStop Color="Transparent" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <!-- 灯体 -->
                <Border x:Name="LedBorder" Margin="2" BorderThickness="0.5" CornerRadius="{{CornerRadius}}">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#999" Opacity="0.3"/>
                    </Border.BorderBrush>
                    <Border.Background>
                        <SolidColorBrush x:Name="LedOffBrush" Color="{{LedOffColor}}"/>
                    </Border.Background>
                </Border>
                <!-- 发光层 -->
                <Border x:Name="LedGlow" Margin="2" Opacity="0" CornerRadius="{{CornerRadius}}">
                    <Border.Background>
                        <RadialGradientBrush>
                            <GradientStop x:Name="GlowCenter" Color="{{LedActiveColor}}" Offset="0.0"/>
                            <GradientStop x:Name="GlowEdge" Color="{{LedActiveColor}}" Offset="0.7"/>
                            <GradientStop Color="Transparent" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <!-- 高光反射 -->
                <Border x:Name="ReflectBorder" Margin="6,5,10,14" Opacity="0.45" CornerRadius="{{CornerRadius}}">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.2">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
